NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Leave empty to use the built-in local MongoDB (persisted in server/.mongo-data)
# For MongoDB Atlas use: mongodb+srv://user:password@cluster.mongodb.net/cofoundr_ai
MONGODB_URI=
USE_MEMORY_MONGO=true
# mongodb-memory-server binary version (8.x can crash on older CPUs; 7.0.14 is stable)
MONGOMS_VERSION=7.0.14

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Cookies are secure by default in production. Set false only for plain-HTTP deployments.
COOKIE_SECURE=false

# Optional LLM enhancement. The rule-based engine works with this disabled.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional SMTP. When empty, password reset links are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CoFoundr AI <no-reply@cofoundr.ai>

ADMIN_EMAIL=admin@cofoundr.ai
ADMIN_PASSWORD=Admin@12345
MAX_UPLOAD_MB=2
